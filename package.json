{
  "name": "invoiceflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "start:backend": "npm --prefix backend run start",
    "worker:backend": "npm --prefix backend run worker",
    "postinstall": "npm --prefix backend run prisma:generate"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.1.0",
    "@azure/storage-blob": "^12.34.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.13",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vitest": "^5.0.4"
  }
}
