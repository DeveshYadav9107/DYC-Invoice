# Environment Configuration for InvoiceFlow
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────
# Get these from Neon Console → Connection Details
DATABASE_URL=
DIRECT_URL=

# ─── Azure AI Document Intelligence ──────────────────────────────
# Get from Azure Portal → Document Intelligence resource → Keys and Endpoint
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# ─── Azure Blob Storage ──────────────────────────────────────────
# Get from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices

# ─── SMTP Email (for OTP delivery) ───────────────────────────────
# Examples: Gmail (smtp.gmail.com:587), SendGrid, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Redis (for BullMQ background jobs) ──────────────────────────
# Examples: redis://localhost:6379, Upstash Redis URL, etc.
REDIS_URL=

# ─── Authentication ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ─── Application ─────────────────────────────────────────────────
APP_URL=http://localhost:3000
UPLOAD_MAX_SIZE_MB=10

# ─── Seed Accounts ───────────────────────────────────────────────
# These accounts are created by `npx prisma db seed`
# They still must authenticate via OTP email verification
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_CLIENT_EMAIL=
SEED_CLIENT_NAME=
SEED_ORGANIZATION_NAME=
